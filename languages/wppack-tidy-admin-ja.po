msgstr "バグ報告 (GitHub)"

#: src/Support/SettingsPage.php
msgid "Disable tidying entirely per plugin, or feature by feature."
msgstr "プラグインごとに整理を完全に無効化するか、機能単位で無効化できます。"

#: src/Support/SettingsPage.php
msgid "Enable"
msgstr "有効にする"

#: src/Modules
msgid "Move upgrade menus to the Upgrades panel"
msgstr "アップグレード系メニューをアップグレードパネルへ移設"

#: src/Modules
msgid "Move Premium feature pages to the Upgrades panel"
msgstr "プレミアム機能ページをアップグレードパネルへ移設"

#: src/Modules
msgid "Move documentation and support links to the Help panel"
msgstr "ドキュメント・サポートのリンクをヘルプパネルへ移設"

#: src/Modules
msgid "Remove upgrade links from the plugin list"
msgstr "プラグイン一覧からアップグレードリンクを除去"

#: src/Modules
msgid "Remove the review request"
msgstr "レビュー依頼を除去"

#: src/Modules
msgid "Show sale notices only in the Upgrades panel"
msgstr "セール通知はアップグレードパネル内のみに表示"

#: src/Modules
msgid "Move the setup notice to the plugin screens and dashboard widget"
msgstr "セットアップ通知をプラグイン画面とダッシュボードウィジェットへ移設"

#: src/Modules/AllInOneSeo.php
msgid "Keep the post-list title column readable beside its SEO column"
msgstr "投稿一覧のタイトル列を SEO 列の隣で読みやすい幅に保つ"

#: src/Modules
msgid "Hide upsell promotions on its screens"
msgstr "画面内のアップセル宣伝を非表示"

#: src/Modules
msgid "Integrate the Help and Upgrades buttons into the page header"
msgstr "ヘルプ / アップグレードボタンをページヘッダーに統合"

#: src/Modules/Bnfw.php
msgid "Remove the third-party SMTP plugin recommendation"
msgstr "他社 SMTP プラグインの推奨通知を除去"

#: src/Modules/BrokenLinkChecker.php
msgid "Move the free-plugins page to the Help panel"
msgstr "無料プラグイン一覧ページをヘルプパネルへ移設"

#: src/Modules/BrokenLinkChecker.php
msgid "Remove the Cloud Link Checker cross-sell"
msgstr "Cloud Link Checker のクロスセルを除去"

#: src/Modules/BrokenLinkChecker.php
msgid "Hide the stray empty heading on its pages"
msgstr "ページ内の余分な空見出しを非表示"

#: src/Modules/EmbedPress.php
msgid "Remove the milestone celebration popup"
msgstr "マイルストーン祝賀ポップアップを除去"

#: src/Modules/EmbedPress.php
msgid "Remove the floating quick-links menu"
msgstr "フローティングのクイックリンクメニューを除去"

#: src/Modules/InstagramFeed.php
msgid "Remove marketing notices and announcements"
msgstr "マーケティング通知・お知らせを除去"

#: src/Modules/LocationWeather.php
msgid "Remove promotional notices and popups"
msgstr "宣伝通知・ポップアップを除去"

#: src/Modules/LocationWeather.php
msgid "Move the weather editor's Pro pitches to the Upgrades panel"
msgstr "ウェザーエディター内の Pro 宣伝をアップグレードパネルへ移設"

#: src/Modules/LocationWeather.php src/Modules/WpMailSmtp.php
msgid "Restore the standard admin footer"
msgstr "標準の管理画面フッターを復元"

#: src/Modules/LocationWeather.php
msgid "Skip the unused block-editor promo bundle"
msgstr "未使用のブロックエディター宣伝バンドルを読み込まない"

#: src/Modules/Mc4wp.php
msgid "Remove Premium ads from its screens"
msgstr "画面内の Premium 広告を除去"

#: src/Modules/Mc4wp.php
msgid "Hide the \"You are here\" breadcrumb"
msgstr "「You are here」パンくずを非表示"

#: src/Modules/PostTypesOrder.php src/Modules/TaxonomyTermsOrder.php
msgid "Hide the advanced-version promo box"
msgstr "上位版の宣伝ボックスを非表示"

#: src/Modules/PostTypesOrder.php src/Modules/TaxonomyTermsOrder.php
msgid "Remove the icon from its Settings menu item"
msgstr "設定メニュー項目のアイコンを除去"

#: src/Modules/PublishPressFuture.php
msgid "Show Scheduled Actions in the sidebar instead of a page button"
msgstr "Scheduled Actions をページ内ボタンではなくサイドバーに表示"

#: src/Modules/PublishPressFuture.php
msgid "Hide locked Pro settings rows"
msgstr "ロックされた Pro 設定行を非表示"

#: src/Modules/PublishPressFuture.php
msgid "Remove the \"You're using the Free version\" bar"
msgstr "「無料版を使用中」バーを除去"

#: src/Modules/WpMailSmtp.php
msgid "Remove the \"You're using Lite\" notice bar"
msgstr "「Lite を使用中」通知バーを除去"

#: src/Modules/WpMailSmtp.php
msgid "Remove the Backup Connection teaser"
msgstr "Backup Connection のティーザーを除去"

#: src/Modules/WpMailSmtp.php
msgid "Remove the SendLayer setup banner"
msgstr "SendLayer セットアップバナーを除去"

#: src/Modules/WpMailSmtp.php
msgid "Remove Pro-only education tabs"
msgstr "Pro 専用の紹介タブを除去"

#: src/Modules/WpMailSmtp.php
msgid "Remove Pro-only teaser mailers from the mailer list"
msgstr "メーラー一覧から Pro 専用ティーザーを除去"

#: src/Modules/WpMailSmtp.php
msgid "Always show the Scheduled Actions tools page"
msgstr "Scheduled Actions ツールページを常に表示"

#: src/Modules/WpMailSmtp.php
msgid "Remove the dashboard widget's Pro teaser chart"
msgstr "ダッシュボードウィジェットの Pro ティーザーチャートを除去"

#: src/Modules/WpMailSmtp.php
msgid "Hide the license fields (turn off while entering a key)"
msgstr "ライセンス項目を非表示（キー入力・確認時はオフに）"

#: src/Modules/AllInOneSeo.php
msgid "Remove its news dashboard widget"
msgstr "ニュース系のダッシュボードウィジェットを除去"

#: src/Modules/AllInOneSeo.php
msgid "Move the \"multiple SEO plugins\" warning to the setup widget"
msgstr "「複数の SEO プラグイン」警告をセットアップウィジェットへ移設"

#: src/Modules/AllInOneSeo.php
msgid "Stop AIOSEO from adding AI buttons to the editor"
msgstr "エディターへの AI ボタン自動追加を防止"

#: src/Modules/AllInOneSeo.php
msgid "Disable all AI features"
msgstr "すべての AI 機能を無効化"

#: src/Modules/AllInOneSeo.php
msgid "Remove the border on its editor toolbar icons"
msgstr "エディターツールバーのアイコンの枠線を除去"

#: src/Modules/AllInOneSeo.php
msgid "Hide the AI credits upsell"
msgstr "AI クレジットのアップセルを非表示"

#: src/Modules/AllInOneSeo.php
msgid "Fix styling conflicts with WordPress core"
msgstr "WordPress コアとのスタイル競合を修正"

#: src/Modules/Yoast.php
msgid "Remove the HelpScout support beacon"
msgstr "HelpScout サポートビーコンを除去"

#: src/Modules/Yoast.php
msgid "Remove upgrade items from the admin bar"
msgstr "管理バーからアップグレード項目を除去"

#: src/Modules/Yoast.php
msgid "Disable promotional introduction popups"
msgstr "宣伝の紹介ポップアップを無効化"

#: src/Modules/Yoast.php
msgid "Stop the webinar promo notice"
msgstr "ウェビナー宣伝通知を停止"

#: src/Modules/Yoast.php
msgid "Use the freed upsell space for content"
msgstr "空いたアップセル領域をコンテンツの表示に活用"
