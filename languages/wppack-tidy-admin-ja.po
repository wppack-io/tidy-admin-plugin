#. Description of the plugin
msgid "Tidy up wp-admin — take plugin vendors' upsells, promos and notices out of the flow. Per-plugin modules activate only when the target plugin is active."
msgstr "wp-admin を整頓 — プラグインベンダーのアップセル・宣伝・通知を導線の外へ。対象プラグインが有効なときだけ、プラグインごとのモジュールが働きます。"

#: src/Support/SubmenuCleaner.php
msgid "Upgrades"
msgstr "アップグレード"

#: src/Support/SubmenuCleaner.php
msgid "Upgrade"
msgstr "アップグレード"

#: src/Support/SubmenuCleaner.php
msgid "Premium features"
msgstr "プレミアム機能"

#: src/Support/SetupNoticeRelocator.php
msgid "Pending plugin setup"
msgstr "セットアップが必要なプラグイン"

#: src/Support/WordPressOrgLinks.php
msgid "Plugin page"
