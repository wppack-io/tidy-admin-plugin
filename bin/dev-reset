#!/bin/sh
#
# Resets the browser-testing WordPress (http://localhost:8082) to a fresh
# install: drops all tables, reinstalls, clears uploads, and reactivates all
# plugins. Also bootstraps the dev-only files under the gitignored web/ on
# first run. Requires the dev database (docker compose up -d mysql).
#
# Usage: [TIDY_ADMIN_DEV_PORT=8080] bin/dev-reset

set -eu
cd "$(dirname "$0")/.."

PORT="${TIDY_ADMIN_DEV_PORT:-8080}"
URL="http://localhost:$PORT"

# --- Dev-only files (web/ is gitignored; this script is their canonical source) ---

if [ ! -f web/wp-config.php ]; then
    cat > web/wp-config.php <<'PHP'
<?php

declare(strict_types=1);

// Dev-only config for browser testing, generated by bin/dev-reset.

// Composer autoloader
require_once dirname(__DIR__) . '/vendor/autoload.php';

if (!defined('ABSPATH')) {
    define('ABSPATH', __DIR__ . '/wp/');
}
// Derive the base URL from the request so the port is not baked in
// (bin/dev-server picks the port; CLI falls back to TIDY_ADMIN_DEV_PORT).
$devHost = $_SERVER['HTTP_HOST'] ?? ('localhost:' . (getenv('TIDY_ADMIN_DEV_PORT') ?: '8080'));
define('WP_CONTENT_DIR', __DIR__ . '/wp-content');
define('WP_HOME', "http://{$devHost}");
define('WP_SITEURL', WP_HOME . '/wp');
define('WP_CONTENT_URL', WP_HOME . '/wp-content');

define('DB_NAME', 'tidy_admin_dev');
define('DB_USER', 'root');
define('DB_PASSWORD', 'password');
define('DB_HOST', '127.0.0.1:3308');
define('DB_CHARSET', 'utf8');
define('DB_COLLATE', '');
$table_prefix = 'wpdev_';

define('WP_DEBUG', true);
define('WP_DEBUG_LOG', true);
define('WP_DEBUG_DISPLAY', false);
define('WP_ENVIRONMENT_TYPE', 'local');
define('AUTOMATIC_UPDATER_DISABLED', true);

// Auth keys (dev only — do not use in production)
define('AUTH_KEY', 'tidy-admin-dev-auth-key');
define('SECURE_AUTH_KEY', 'tidy-admin-dev-secure-auth-key');
define('LOGGED_IN_KEY', 'tidy-admin-dev-logged-in-key');
define('NONCE_KEY', 'tidy-admin-dev-nonce-key');
define('AUTH_SALT', 'tidy-admin-dev-auth-salt');
define('SECURE_AUTH_SALT', 'tidy-admin-dev-secure-auth-salt');
define('LOGGED_IN_SALT', 'tidy-admin-dev-logged-in-salt');
define('NONCE_SALT', 'tidy-admin-dev-nonce-salt');

require_once ABSPATH . 'wp-settings.php';
PHP
    echo 'created:  web/wp-config.php'
fi

if [ ! -f web/index.php ]; then
    cat > web/index.php <<'PHP'
<?php

// Dev-only front controller, generated by bin/dev-reset.

define('WP_USE_THEMES', true);
require __DIR__ . '/wp/wp-blog-header.php';
PHP
    echo 'created:  web/index.php'
fi

# A real file, NOT a symlink to the repo root: wp_register_plugin_realpath()
# would map the plugin dir to the repo root — an ancestor of web/ — corrupting
# plugin_basename()/plugins_url() for every plugin under web/wp-content/plugins/.
if [ ! -f web/wp-content/plugins/tidy-admin/wppack-tidy-admin.php ]; then
    mkdir -p web/wp-content/plugins/tidy-admin
    cat > web/wp-content/plugins/tidy-admin/wppack-tidy-admin.php <<'PHP'
<?php

/**
 * Plugin Name: WPPack Tidy Admin
 * Description: Dev stub generated by bin/dev-reset — loads the plugin from the repository root.
 * Version: 1.0.0
 * Requires PHP: 8.2
 * Requires at least: 6.7
 * Author: WPPack
 * License: MIT
 */

declare(strict_types=1);

if (!defined('ABSPATH')) {
    exit;
}

require dirname(__DIR__, 4) . '/wppack-tidy-admin.php';
PHP
    echo 'created:  web/wp-content/plugins/tidy-admin/wppack-tidy-admin.php'
fi

# --- Reset ---

vendor/bin/wp db reset --yes

rm -rf web/wp-content/uploads
mkdir -p web/wp-content/uploads

rm -f web/wp-content/debug.log

vendor/bin/wp core install \
    --url="$URL" \
    --title='Tidy Admin Dev' \
    --admin_user=admin \
    --admin_password=password \
    --admin_email=admin@example.test \
    --skip-email

# Instagram Feed's < 1.7 DB migration runs a GDPR image-editor self-test that
# crashes WP loading when offline (passes a WP_Error to wp_get_image_editor()).
# Mark the migrations as done before the plugin first loads.
SBI_DBVERSION=$(sed -n "s/.*define('SBI_DBVERSION', '\([^']*\)').*/\1/p" web/wp-content/plugins/instagram-feed/instagram-feed.php)
vendor/bin/wp option update sbi_db_version "${SBI_DBVERSION:-2.4}"

vendor/bin/wp plugin activate --all

# Wordfence resolves the site's host with dns_get_record() on every admin
# request (wfUtils::serverIPs). It resolves `localhost:8082` — WP_HOME includes
# the dev port, which is not a valid hostname — so the lookup stalls for the
# full 30s (its max_execution_time) instead of failing fast, and on the
# single-threaded dev server that takes the whole site down. It checks a cached
# 'serverDNS' value first (format 'timestamp;ttl;ip') and skips the lookup when
# still valid, so seed a long-lived one. The wfconfig table exists only after
# activation, hence this runs last.
PREFIX="$(vendor/bin/wp config get table_prefix)"
vendor/bin/wp db query "INSERT INTO ${PREFIX}wfconfig (name, val, autoload) VALUES \
  ('serverDNS', CONCAT(UNIX_TIMESTAMP(), ';315360000;127.0.0.1'), 'yes'), \
  ('serverIP', CONCAT(UNIX_TIMESTAMP(), ';127.0.0.1'), 'yes') \
  ON DUPLICATE KEY UPDATE val = VALUES(val)"

echo
echo "Reset complete: $URL/wp/wp-admin/ (admin / password)"
echo "Server: vendor/bin/wp server"
